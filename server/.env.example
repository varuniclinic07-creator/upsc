# Copy to .env on the server. Never commit .env.
# COMFY_PASS_HASH is generated with: caddy hash-password
# (it asks for the password and prints a bcrypt hash starting with $2a$).

COMFY_USER=admin
COMFY_PASS_HASH=

# Phase B (named tunnel on a custom domain). Leave blank for Phase A
# (cloudflared quick tunnel, random *.trycloudflare.com URL).
TUNNEL_NAME=

# Where ComfyUI is installed (set by setup_comfyui.sh).
COMFYUI_DIR=/workspace/ComfyUI

# Local port Caddy listens on. Default 8181. Avoid 8080 — Vast.ai's
# docker-proxy / Jupyter often binds it.
CADDY_PORT=8181
